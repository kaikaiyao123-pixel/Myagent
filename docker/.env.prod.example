# =============================================================================
# AgentChat 生产环境变量模板
#
# 用法：复制为 docker/.env 后填写。
#   cp docker/.env.prod.example docker/.env
#
# ⚠️ docker/.env 已在 .gitignore 中，绝不会被提交。请勿把真实值写进本模板。
#
# 其中标注「自动生成」的项若留空，deploy.sh 会用安全随机值自动填充。
# =============================================================================

# ---------------------------------------------------------------------------
# 中间件口令
# ---------------------------------------------------------------------------
# MySQL root 口令（原开发默认 123456，生产必须更换）
MYSQL_ROOT_PASSWORD=

# MinIO 对象存储凭据（原开发默认 minioadmin/minioadmin，生产必须更换）
# ⚠️ 用户名不得少于 3 字符，口令不得少于 8 字符，否则 MinIO 拒绝启动
MINIO_ROOT_USER=agentchat
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# 应用密钥
# ---------------------------------------------------------------------------
# JWT 签名密钥（自动生成）
# 原代码硬编码为字面量 'secret'，任何人都可据此伪造 token 冒充任意用户
AUTHJWT_SECRET_KEY=

# ---------------------------------------------------------------------------
# 运行参数
# ---------------------------------------------------------------------------
# uvicorn worker 数。2 核 4G 建议 2；4 核 8G 可设 4
UVICORN_WORKERS=2

# 后端容器资源上限（docker-compose.prod.yml 里通过 deploy.resources.limits 生效）
# limits 是「上限」而非「预留」，各项之和可以超过物理内存。
# 2C4G 机器用默认值；4C8G 建议 BACKEND_CPUS=4 / BACKEND_MEM_LIMIT=5g
# ⚠️ 设得过低的表现是「长对话（SSE 长连接）中途被 OOM kill」，而不是启动失败。
BACKEND_CPUS=2.0
BACKEND_MEM_LIMIT=3g

# CORS 允许来源（逗号分隔）。同源部署（Nginx 同时托管前端与 /api）时留空即可。
# 仅在前后端分离部署时才需要填写，例如：https://your-domain.com
CORS_ALLOW_ORIGINS=

# ---------------------------------------------------------------------------
# 部署自检 / 冷启动预热（可选）
# ---------------------------------------------------------------------------
# 填了这两个值后，deploy.sh 的验收阶段会走一遍真实链路
# （登录 → 取 Agent → 建会话 → 发一条「你好」）把懒初始化提前做掉，
# 避免第一个真实用户撞上约 90 秒的首字延迟。
#
# ⚠️ 必须是【已注册】的账号。deploy.sh 不会创建账号，也不该硬编码口令。
#    留空则跳过预热，脚本会提示你手动登录发一条消息。
#    不填不影响部署结果（预热是优化项，任何一步失败只告警）。
WARMUP_USER=
WARMUP_PASSWORD=

# ---------------------------------------------------------------------------
# 模型服务 API Key
# ---------------------------------------------------------------------------
# 阿里云百炼 DashScope：对话/工具调用/视觉/文生图/Embedding/Rerank 均依赖它
#
# 【必填】deploy.sh 会在此项为空时直接中止部署。
# 原因：首次启动若 Key 为空，初始化会把空 Key 写入 llm 表，且默认 Agent 会
# 永久绑定到这条记录；事后补 Key 不会自动修复（_update_exist_llm 只更新
# 最早创建的那条 LLM），只能手工改库。表现为「页面正常，一发消息就 401」。
DASHSCOPE_API_KEY=

# 如需先只跑通页面、暂不启用对话，可设为 1 跳过上述强制检查（需自行承担改库成本）
# SKIP_LLM_KEY_CHECK=0

# DeepSeek：复杂推理模型（可选，留空则该模型不可用，不影响启动）
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# 外部工具 API Key（可选）
# ---------------------------------------------------------------------------
# 高德地图（天气）
AMAP_API_KEY=
# Tavily（联网搜索）
TAVILY_API_KEY=
# SerpApi（Google 搜索）
SERPAPI_KEY=
# 阿里云快递查询
DELIVERY_API_KEY=
# BoCha（联网搜索）
BOCHA_API_KEY=

# ---------------------------------------------------------------------------
# 微信集成（可选）
# ---------------------------------------------------------------------------
WECHAT_TOKEN=
WECHAT_APP_ID=
WECHAT_SECRET=

# ---------------------------------------------------------------------------
# Langfuse 追踪（可选）
# 公私钥必须成对填写；只填一个会被部署脚本拦截。
# 两个都留空 = 关闭追踪（默认）。Host 默认 Langfuse Cloud，自托管时改此项。
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---------------------------------------------------------------------------
# 语义缓存（可选，默认关闭）
# 只适用于「单轮、自包含」的知识库问答 / FAQ；多轮对话不要开。
#   ENABLED   : true/false，默认 false。threshold 未经校准时不要打开。
#   THRESHOLD : 余弦相似度阈值，必须在 (0,1) 开区间；
#               用 scripts/calibrate_threshold.py 在校准集上标定后填写。
#   TTL       : 条目过期秒数，默认 86400（1 天），命中后刷新。
#   KB_VERSION: 知识库版本标识；知识库更新后递增（如 v1 -> v2）即使旧缓存逻辑失效。
# ---------------------------------------------------------------------------
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.90
SEMANTIC_CACHE_TTL=86400
SEMANTIC_CACHE_KB_VERSION=v1

# ---------------------------------------------------------------------------
# 阿里云 OSS（可选；storage.mode 为 minio 时不需要）
# ---------------------------------------------------------------------------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
