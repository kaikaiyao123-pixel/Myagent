# =============================================================================
# AgentChat 生产环境变量模板
#
# 用法：复制为 docker/.env 后填写。
#   cp docker/.env.prod.example docker/.env
#
# ⚠️ docker/.env 已在 .gitignore 中，绝不会被提交。请勿把真实值写进本模板。
#
# 其中标注「自动生成」的项若留空，deploy.sh 会用安全随机值自动填充。
# =============================================================================

# ---------------------------------------------------------------------------
# 中间件口令
# ---------------------------------------------------------------------------
# MySQL root 口令（原开发默认 123456，生产必须更换）
MYSQL_ROOT_PASSWORD=

# MinIO 对象存储凭据（原开发默认 minioadmin/minioadmin，生产必须更换）
# ⚠️ 用户名不得少于 3 字符，口令不得少于 8 字符，否则 MinIO 拒绝启动
MINIO_ROOT_USER=agentchat
MINIO_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# 应用密钥
# ---------------------------------------------------------------------------
# JWT 签名密钥（自动生成）
# 原代码硬编码为字面量 'secret'，任何人都可据此伪造 token 冒充任意用户
AUTHJWT_SECRET_KEY=

# ---------------------------------------------------------------------------
# 运行参数
# ---------------------------------------------------------------------------
# uvicorn worker 数。2 核 4G 建议 2；4 核 8G 可设 4
UVICORN_WORKERS=2

# CORS 允许来源（逗号分隔）。同源部署（Nginx 同时托管前端与 /api）时留空即可。
# 仅在前后端分离部署时才需要填写，例如：https://your-domain.com
CORS_ALLOW_ORIGINS=

# ---------------------------------------------------------------------------
# 模型服务 API Key
# ---------------------------------------------------------------------------
# 阿里云百炼 DashScope：对话/工具调用/视觉/文生图/Embedding/Rerank 均依赖它
#
# 【必填】deploy.sh 会在此项为空时直接中止部署。
# 原因：首次启动若 Key 为空，初始化会把空 Key 写入 llm 表，且默认 Agent 会
# 永久绑定到这条记录；事后补 Key 不会自动修复（_update_exist_llm 只更新
# 最早创建的那条 LLM），只能手工改库。表现为「页面正常，一发消息就 401」。
DASHSCOPE_API_KEY=

# 如需先只跑通页面、暂不启用对话，可设为 1 跳过上述强制检查（需自行承担改库成本）
# SKIP_LLM_KEY_CHECK=0

# DeepSeek：复杂推理模型（可选，留空则该模型不可用，不影响启动）
DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# 外部工具 API Key（可选）
# ---------------------------------------------------------------------------
# 高德地图（天气）
AMAP_API_KEY=
# Tavily（联网搜索）
TAVILY_API_KEY=
# SerpApi（Google 搜索）
SERPAPI_KEY=
# 阿里云快递查询
DELIVERY_API_KEY=
# BoCha（联网搜索）
BOCHA_API_KEY=

# ---------------------------------------------------------------------------
# 微信集成（可选）
# ---------------------------------------------------------------------------
WECHAT_TOKEN=
WECHAT_APP_ID=
WECHAT_SECRET=

# ---------------------------------------------------------------------------
# Langfuse 追踪（可选）
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---------------------------------------------------------------------------
# 阿里云 OSS（可选；storage.mode 为 minio 时不需要）
# ---------------------------------------------------------------------------
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
